{
    "name": "xoubaman/builder",
    "description": "A library for reusable builders",
    "type": "library",
    "keywords": [
        "testing"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Carlos Gándara",
            "email": "xoubaman@hey.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "roave/better-reflection": "^6.69",
        "symfony/console": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "roave/security-advisories": "dev-master",
        "phpunit/phpunit": "^11.5",
        "mikey179/vfsstream": "^1.6.12",
        "carthage-software/mago": "^1.47.2"
    },
    "autoload": {
        "psr-4": {
            "Xoubaman\\Builder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Xoubaman\\Builder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/mago lint",
        "style": "vendor/bin/mago format --check",
        "fix-style": "vendor/bin/mago format",
        "all-checks": [
            "vendor/bin/mago lint",
            "vendor/bin/mago format --check",
            "vendor/bin/phpunit"
        ]
    },
    "bin": [
        "bin/builder"
    ]
}
